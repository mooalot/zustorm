// Type-checks the example apps against the library source, so they cannot
// drift from the API. Run with `npm run type-check:examples`.
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "zustorm": ["./src"]
    }
  },
  "include": ["examples/*/src", "tests/project/src"]
}
