{
  "name": "zustorm",
  "version": "1.0.20",
  "description": "Powerful form management with Zustand and Zod validation",
  "author": "Gabriel Saunders",
  "repository": {
    "type": "git",
    "url": "https://github.com/mooalot/zustorm"
  },
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "zustand",
    "form",
    "forms"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest --typecheck",
    "bench": "vitest bench --run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/*.{ts,tsx}\" \"tests/*.test-d.ts\" \"bench/**/*.{ts,tsx}\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/*.{ts,tsx}\" \"bench/**/*.{ts,tsx}\" README.md",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@hookform/resolvers": "^5.9.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "proxy-compare": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "ts-expect": "^1.3.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.2",
    "zod": "^3.24.4",
    "zundo": "^2.3.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "zod": ">=3.0.0",
    "zustand": ">=5.0.0"
  },
  "engines": {
    "typescript": ">=5.4.0"
  },
  "license": "MIT"
}
