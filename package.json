{
  "name": "zustorm",
  "version": "2.0.0",
  "description": "Form state for Zustand with Standard Schema validation (Zod, Valibot, ArkType, ...)",
  "author": "Gabriel Saunders",
  "repository": {
    "type": "git",
    "url": "https://github.com/mooalot/zustorm"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "zustand",
    "form",
    "forms",
    "zod",
    "valibot",
    "standard-schema",
    "validation"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp dist/index.d.ts dist/index.d.cts",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.examples.json",
    "test": "vitest --typecheck",
    "bench": "vitest bench --run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/*.{ts,tsx}\" \"tests/*.test-d.ts\" \"bench/**/*.{ts,tsx}\" \"examples/*/src/*.tsx\" \"tests/project/src/*.tsx\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/*.{ts,tsx}\" \"bench/**/*.{ts,tsx}\" \"examples/*/src/*.tsx\" \"tests/project/src/*.tsx\" README.md",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "type-check:examples": "tsc -p tsconfig.examples.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@hookform/resolvers": "^5.9.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "proxy-compare": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "valibot": "^1.5.0",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "zod": ">=3.24.0",
    "zustand": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "typescript": ">=5.4.0"
  },
  "license": "MIT"
}
